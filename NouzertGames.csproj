<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Single File Executable Configuration -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    
    <!-- Application Information -->
    <AssemblyName>NouzertGames</AssemblyName>
    <RootNamespace>NouzertGames</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Nouzert</Authors>
    <Company>Nouzert</Company>
    <Description>NouzertTools - RyuManifest Integration Tool</Description>
    <ApplicationIcon>nouzertool.ico</ApplicationIcon>
    
    <!-- Windows Specific -->
    <UseWindowsForms>false</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="nouzertool.ico" />
  </ItemGroup>

</Project>
