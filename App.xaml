<Application x:Class="NouzertGames.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NouzertGames"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <!-- Nouzert Engine Premium Tech Theme Colors -->
        <SolidColorBrush x:Key="NouzertBgDeep" Color="#0B0C10"/>
        <SolidColorBrush x:Key="NouzertBgCard" Color="#1F2833"/>
        <SolidColorBrush x:Key="NouzertBgHover" Color="#2C3540"/>
        <SolidColorBrush x:Key="NouzertAccent" Color="#66FCF1"/>
        <SolidColorBrush x:Key="NouzertAccentDim" Color="#45A29E"/>
        <SolidColorBrush x:Key="NouzertGreen" Color="#2ECC71"/>
        <SolidColorBrush x:Key="NouzertRed" Color="#E74C3C"/>
        <SolidColorBrush x:Key="NouzertTextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="NouzertTextSecondary" Color="#C5C6C7"/>
    </Application.Resources>
</Application>